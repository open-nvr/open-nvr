# OpenNVR - Environment Configuration (single source of truth)
#
# You normally DON'T touch this file by hand. Just run the launcher:
#     ./start.sh      (Linux / macOS)
#     start.ps1       (Windows)
# On first run it copies this template to .env, generates strong secrets,
# and walks you through the handful of settings most people change. Every
# service in docker-compose.yml and the examples reads its config from the
# resulting .env - change a value there and re-run ./start.sh to apply it.
#
# ! The default secrets below are LOCAL-DEV placeholders. The installer
#   replaces them with random values automatically; never ship these as-is.

# ============================================================
# DATABASE
# ============================================================
POSTGRES_USER=opennvr_user
POSTGRES_PASSWORD=dev_postgres_pass_2024     # ! change for production
POSTGRES_DB=opennvr_db

# ============================================================
# SECURITY & AUTHENTICATION
# ============================================================
SECRET_KEY=dev_jwt_secret_key_f8a4b2c9e1d7a5f3b8c4e2a9d6f1b7c3   # ! change: openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
CREDENTIAL_ENCRYPTION_KEY=CKLghtP4rWz8J9vN2xQ5mT7yU8kF6bD3eH1aG4cS0wE=   # ! change - never change after first run
INTERNAL_API_KEY=dev_internal_api_key_h9j2k5l8m3n6p1q4   # ! change: openssl rand -base64 32
MEDIAMTX_SECRET=dev_mediamtx_webhook_secret_x7y2z5a8b3c6d1e4   # ! change: openssl rand -hex 32

# Tier-0 detect-pipeline (always-on motion→detect→track per camera).
# On by default; set to false to disable without a redeploy.
DETECT_PIPELINE_ENABLED=true

# Frames analyzed per second per camera (1-30, default 2). Detection runs
# on every analyzed frame, so pipeline CPU scales ~linearly with this.
# 2 is the CPU-friendly default that behaves well on laptops and ANY
# macOS/Windows Docker install (the VM has no GPU). Servers with headroom
# — and especially hosts with DETECT_HWACCEL set — can raise it to 5-10
# for finer motion/track granularity.
DETECT_FPS=2

# Stationary-track gating: once an object has held still for 50 FRAMES
# (~25 s at DETECT_FPS=2 — the threshold counts frames, so it halves if
# you double the fps) it stops being re-detected every frame and is
# re-verified every Nth frame instead
# (staggered per object; any motion touching it re-checks immediately).
# This is what keeps a parked car or a person sitting still from pinning
# the detector at full rate forever. 0 disables (every track, every frame).
DETECT_STATIONARY_INTERVAL=10

# ── Bounded-load guards ─────────────────────────────────────────────
# Together these keep Tier-0's worst-case CPU flat no matter what the
# camera sees. Field case: a desk full of wires/boards made yolov8n (at
# conf 0.25, all 80 COCO classes) hallucinate "kite"/"banana" phantoms;
# 181 of them confirmed into standing tracks and re-verifying them pushed
# the detector to ~30s/frame. The defaults below make that impossible.
#
# Classes worth TRACKING (comma-separated; "all" = every COCO class).
# An NVR rarely cares about bananas — Frigate ships person-only.
# A camera's ``object_detection`` assignment (camera settings page) may
# carry its own labels — "camera 4 wants person + truck" — which replace
# this global set FOR THAT CAMERA only. See docs/CAMERA_ASSIGNMENTS.md.
DETECT_LABELS=person,car,truck,bus,motorcycle,bicycle,cat,dog

# Opt-in CPU saving: skip Tier-0 analysis on cameras whose assignments are
# all detection-free (e.g. an LPR-only camera). OFF by default because the
# Tier-0 stream feeds more than detection apps (footage-search indexes it,
# the agent's events skill reads it) — skipping is an explicit choice.
# Cameras with NO assignments are never skipped.
DETECT_SKIP_UNASSIGNED=false

# Which stream Tier-0 detection (and the agent's frame grabs) decode when a
# camera has a substream: auto (default — substream on CPU-only decode, the
# full MAIN stream when the reader can genuinely hardware-decode: a GPU box
# can afford full-res decode and gets full-res evidence crops; detection
# accuracy is equal either way, the model input is a fixed square), sub
# (always the substream when one exists), main (always full-res). Cameras
# with no substream use the main stream regardless.
#
# On 'auto' the decision follows the reader's RESOLVED capability, which the
# detect-pipeline reports on every discovery request — not DETECT_HWACCEL on
# its own. Declaring a GPU you cannot reach no longer buys the main stream.
# 'sub' and 'main' are explicit operator choices and outrank all of it.
INFERENCE_TAP_STREAM=auto
# Detector confidence floor (default 0.4). Real people/vehicles usually
# score >0.6; wire-phantoms live in the 0.25-0.4 band.
DETECT_CONF=0.4
# Hard cap on detector crops per frame (default 8; 0 = unbounded).
# Motion regions get slots first; track re-verifies round-robin the rest.
DETECT_MAX_REGIONS=8
# Hard cap on live tracks per camera (default 50). At the cap new tracks
# are refused (tier0_track_spawns_dropped) until the TTL drains old ones.
DETECT_MAX_TRACKS=50
# Wall-clock seconds a track may live without a positive re-detection
# (default 300; 0 = never expire). Real objects are simply re-detected.
DETECT_TRACK_TTL=300
# Minimum detection score to CREATE a track (default 0.5). Weaker hits
# still match existing tracks — hysteresis, like Frigate min_score.
DETECT_MIN_SPAWN_SCORE=0.5

# Motion gate (#373). The gate skips the detector until the scene
# "calibrates" (a frame with <5% motion). A permanently busy scene
# (trees, rain, a busy road) never calibrates, so the deadline forces
# the gate open after N consecutive calibrating frames — a WARN names
# the camera when that happens. 0 restores the old wedge-able behavior.
# 150 frames ≈ 75 s at the default DETECT_FPS=2.
DETECT_MOTION_CALIBRATION_MAX_FRAMES=150
# Consecutive deadline hits before the gate gives up on the scene and
# LATCHES OPEN (detector on every frame). The deadline above bounds one
# episode, but a scene with no STATIC BACKGROUND — a PTZ mid-pan, a
# moving/handheld source, a mast in high wind — re-trips calibration at
# once, turning the deadline into a duty cycle: ~1 analysed frame per
# DETECT_MOTION_CALIBRATION_MAX_FRAMES, indefinitely, and quietly (the
# repeat WARN is demoted to debug). Latching makes that loud, bounded
# and per-camera; a quiet frame releases it. 0 = deadline only.
# 2 x 150 frames is ~150 s at DETECT_FPS=2 before giving up.
DETECT_MOTION_MAX_FORCED_EXITS=2
# Raise on noisy sensors (fewer phantom motion pixels); 1-255.
DETECT_MOTION_THRESHOLD=30
# Minimum contour area counted as motion; raise to ignore small flicker.
DETECT_MOTION_CONTOUR_AREA=10
# Background adapt rate in steady state.
DETECT_MOTION_FRAME_ALPHA=0.01
# Frame fraction that re-triggers calibration (dawn / IR-cut flashes).
DETECT_MOTION_LIGHTNING_THRESHOLD=0.8
# false = motion gate OFF entirely: full-frame detection on every frame.
# The escape hatch for scenes the gate cannot model — costs full-frame
# inference at DETECT_FPS on that camera, so use the tunables first.
# NOTE the gate models a STATIC BACKGROUND. A permanently moving frame
# (moving camera, PTZ that never rests) can never calibrate, and no
# threshold tuning changes that — the frame fraction in motion never
# falls below the 5% "quiet" bar. For such a source this flag is the
# CORRECT setting, not a fallback. This var is global: to un-gate a
# single moving camera in an otherwise fixed fleet, leave it true and
# rely on DETECT_MOTION_MAX_FORCED_EXITS, which latches per-camera.
DETECT_MOTION_ENABLED=true

# ── Multi-frame plate OCR (cameras with the LPR skill only) ────────
# Each vehicle track keeps the top-K plate-readability-scored crops
# spread across its pass, OCR'd best-first at ingest with early exit —
# several diverse attempts per car instead of one. Non-LPR cameras pay
# nothing.
DETECT_PLATE_CANDIDATES=4
# Early attempts: the first OCR fires the moment the track CONFIRMS
# (the read no longer waits for the track to die — minutes, on a busy
# road); a retry fires only for a much-better later frame. Hard
# per-track budget; 0 disables early attempts (ingest sweep only).
DETECT_PLATE_EARLY_ATTEMPTS=2
# Minimum seconds between retained candidates — spreads them across
# the pass so the attempts are diverse, not four copies of one moment.
DETECT_PLATE_CANDIDATE_GAP_S=0.75

# Decode-side frame skip (ffmpeg -skip_frame). Decode — not the model — is
# Tier-0's dominant CPU cost: the camera's full frame rate is decompressed
# even though only DETECT_FPS frames are analyzed. This dial drops frames
# INSIDE the decoder so they're never decompressed at all:
#   nonref (default) skip frames nothing else references — PROVABLY lossless
#          (a dropped frame is one no other frame needs, and the analyzed
#          rate stays far above DETECT_FPS). Free savings where the stream
#          has such frames; zero cost where it doesn't (many cameras encode
#          without B-frames, so there may be nothing to skip).
#   bidir  skip all B-frames — slightly more aggressive; can artifact on the
#          rare stream using B-frames as references (b-pyramid).
#   nokey  keyframes only (~0.5-1 fps) — the deepest cut for CPU-only boxes;
#          plenty for "is someone there" alarms, coarse for fast motion.
#   none   decode everything.
DETECT_DECODE_SKIP=nonref

# ffmpeg decoder threads per camera (default 2; 0 = ffmpeg auto). Auto spawns
# up to 16 frame threads PER CAMERA — pure scheduling overhead on substream-
# sized video, multiplied by the fleet. Thread count never changes decoded
# output, so the cap is lossless. Raise only for a single high-res camera on
# a big machine.
DETECT_DECODE_THREADS=2

# RTSP socket-I/O timeout in seconds (0 disables). ffmpeg has NO read timeout
# by default, so a half-open TCP session — camera powered off mid-stream, or a
# NAT/firewall silently dropping the flow — leaves the decode blocked forever:
# ffmpeg never exits, the restart loop never runs, and the camera is dead with
# nothing in the logs. Raise it for a camera with a very bursty feed.
DETECT_RTSP_TIMEOUT_S=10

# Best-frame crops retained PER CAMERA (default 16). Tier-0 keeps each track's
# best crop so a consumer can fetch "the best frame for the person on cam3"
# instead of grabbing a random live frame. The quota is per camera on purpose:
# with a single global cap a busy camera evicted the quiet ones outright, so
# on a fleet the quiet camera's best frame was simply never there. Raise it
# only if you fetch best frames for many simultaneous tracks on one camera.
DETECT_BESTFRAME_PER_CAMERA=16

# Max resident detector instances (default: auto from CPU count / decoder
# threads, clamped to 2-8). Each instance holds its own model weights and
# activation arenas, so building one PER CAMERA made memory a function of the
# fleet instead of the hardware — at the shipped 640px input that is the wall
# a large install hits first, well before CPU. Workers now borrow from a pool
# for the duration of one inference, which keeps the exclusivity cv2.dnn
# requires while capping how many models are resident. The pool grows lazily,
# so an install with fewer cameras than this is unaffected; sizing against
# cores rather than cameras costs no throughput, because inference is
# CPU-bound and releases the GIL. Set 0 to restore one detector per camera.
DETECT_DETECTOR_POOL=

# Window (seconds) over which a batch of workers opens its streams
# (default 10; 0 = all at once). A reconcile tick starts every new camera in
# the same instant and each one ffprobes then dials RTSP, so a cold start or
# a fleet-wide recovery lands on MediaMTX as N simultaneous session setups.
# Scaled by batch size, so one or two cameras still come up immediately.
DETECT_START_SPREAD_S=10

# Max concurrent Tier-1 (expensive-model) dispatches for the WHOLE fleet
# (default 4). Each camera may hold at most half of these, so one camera with
# several escalating tracks can no longer take every permit in a single frame
# and lock the rest of the fleet out. Over-share dispatches are dropped, not
# queued, and counted per camera on tier1_dispatch_dropped_total.
DETECT_DISPATCH_MAX_INFLIGHT=4

# Hard ceiling on best-frame entries across ALL cameras (0 = no ceiling; the
# per-camera quota above is the only bound). Leave it at 0 unless you need a
# fixed memory bound: a fixed ceiling silently overrules the per-camera quota
# once cameras x quota exceeds it.
DETECT_BESTFRAME_MAX_ENTRIES=0

# Opt-in decode shortcut: skip the h264/h265 in-loop deblocking filter
# (-skip_loop_filter all -flags2 fast). Deblocking exists for VIEWING
# quality — detection is robust to the slight blockiness — but decoded
# pixels drift a little from the encoder between keyframes, so this is NOT
# bit-exact and stays off by default. Worth ~10-20%% of software-decode CPU
# on CPU-only hosts; ignored when DETECT_HWACCEL is set.
DETECT_DECODE_FAST=false

# Adaptive decode — the Blue Iris "limit decoding unless required" pattern,
# ON by default: while a camera's scene is quiet the detector decodes ONLY
# keyframes (~one frame per GOP — an idle camera costs almost nothing), and
# the FIRST motion box or live track promotes it back to full decode
# (demotion after DETECT_DECODE_IDLE_AFTER quiet seconds). RECORDING IS
# UNAFFECTED — the full main stream is always recorded; this only shapes
# what the detector looks at. The trade: the detector's reaction to a brand
# new event on a quiet scene can lag up to one GOP (~1-2 s), and an event
# briefer than the keyframe interval could pass unnoticed while idle (it is
# still in the recording). Set to none if you need sub-second detector
# reaction at all times.
DETECT_DECODE_IDLE=nokey
DETECT_DECODE_IDLE_AFTER=60

DETECT_DETECTOR=onnx       # onnx (YOLOv8, default) | rfdetr (RF-DETR, needs ort +
                           # an rf-detr ONNX export at DETECT_ONNX_MODEL and its
                           # input size in DETECT_ONNX_INPUT) | hog | blob | stub
DETECT_ONNX_BACKEND=auto   # auto (cvdnn for onnx, ort for rfdetr) | cvdnn | ort
# Detector input square. NOTE: this is only tunable if your ONNX model was
# exported with DYNAMIC axes. The yolov8n.onnx this project ships is exported
# at a FIXED 640, so anything else is rejected by the graph — the service now
# detects that at load, warns, and uses the size the model actually accepts
# rather than failing once per region per frame. To genuinely run at 320 (the
# single biggest CPU saving on a CPU-only box), re-export the model at 320 or
# with dynamic axes; setting this alone will not do it.
DETECT_ONNX_INPUT=640

# ORT execution providers, comma-separated, e.g.
# OpenVINOExecutionProvider (Intel N100) or CUDAExecutionProvider.
# NOTE: keep this comment ABOVE the line. An EMPTY value with a trailing
# `# comment` is parsed as the comment itself — this variable used to arrive
# in the container literally set to "# ort EPs, e.g. ...", which then warned
# on every start. Values that are non-empty strip their comment correctly;
# only the empty case breaks.
DETECT_ONNX_PROVIDERS=
# Hardware decode backend. vaapi/qsv/rpi/rkmpp also need the render node
# passed into the detect-pipeline container — uncomment the
# `devices: - /dev/dri:/dev/dri` block in docker-compose.yml (core reads this
# setting too, but only to choose the tap stream; it never decodes, so it
# needs no device).
#
# Getting it half-right is now safe rather than expensive: the pipeline
# resolves what it can ACTUALLY do at startup and reports that to core, so a
# container that cannot see the render node is kept on the cheap substream
# instead of being handed the full-resolution main stream it could only
# decode in software. You get a warning per camera naming the missing device
# — but the CPU bill stays the same as plain `cpu` until you fix it.
DETECT_HWACCEL=cpu         # cpu | vaapi | nvidia | qsv | rpi | rkmpp | jetson
DETECT_GATE_MODE=shadow    # shadow (default: measure only) | off | enforce (act — validate shadow first, see detect-pipeline/ENABLEMENT.md)
# Threads per inference. Leave EMPTY to let the service size it to the fleet:
# at most min(detector-pool, cameras) inferences run at once, so the cores
# divide between them and it is retuned as cameras come and go. A fixed cap is
# right for a large fleet and wastes most of the box for a small one —
# measured on 8 cores with one camera (yolov8n @640): 2 threads 449ms vs
# 8 threads 176ms, near-linear. Set a number to pin it; it is then never
# retuned. 0/empty = automatic — but ONLY on the default cvdnn backend.
# With DETECT_ONNX_BACKEND=ort (or the rfdetr detector) there is no
# auto-tuning: unset pins 2 threads per session, and an explicit 0 hands
# the choice to ONNX Runtime, which claims a full core count per session.
DETECT_CV_THREADS=
DETECT_VISITS_ENABLED=true # persist finished visits + best-frame evidence to the events store
EVENTS_PLATE_ENRICHMENT=true # OCR vehicle visits' best frames (fast_plate_ocr) into plate_text
# Fold repeat plate sightings: the same plate on the same camera within
# this many seconds of its last sighting is ONE sighting — the extra
# visit row keeps no plate and spends no further OCR. Rolling window:
# every sighting (written or folded) restarts it, so a chain of track
# fragments seconds apart collapses no matter its length, while a car
# genuinely returning after a quiet gap is a new row. 0 disables.
OPENNVR_PLATE_DEDUP_WINDOW_S=30
# Reject plate reads the adapter barely LOCALISED. A manufacturer badge
# OCRs into plausible characters (Audi's four rings read as "C00D") at
# plausible read confidence, from a box nowhere near a crop edge — so
# neither the read's confidence nor the partial-read geometry check can
# tell it from a plate. The localiser's own score can: measured on the
# reporting install, genuine plates scored 0.85+ and that badge 0.38.
# Lower it if your camera angle yields habitually weak-but-correct
# finds; 0 disables the gate.
OPENNVR_PLATE_MIN_DETECTION_CONFIDENCE=0.6
DETECT_METRICS_PORT=9109   # Prometheus /metrics on the detect-pipeline (0 disables)
# Set (e.g. http://kai-c:8100) to run the gated model via KAI-C; empty = off.
# Comment ABOVE the line on purpose: an empty value with a trailing comment is
# parsed as the comment, so this arrived set to "# set (e.g. ..." — truthy, so
# the service reported dispatch as configured against a URL that cannot resolve.
DETECT_DISPATCH_KAIC_URL=

# ============================================================
# APPLICATION SETTINGS
# ============================================================
# DEBUG applies to host-native backend dev. The Docker core service reads
# OPENNVR_DEBUG instead (kept separate so a stray host DEBUG=release can't
# break the backend's boolean parsing). Leave both False for normal use.
DEBUG=False
OPENNVR_DEBUG=False
HOST=0.0.0.0
PORT=8000
APPLICATION_URL=http://localhost:8000
API_PREFIX=/api/v1

# ============================================================
# MEDIAMTX STREAMING SERVER
# ============================================================
# NOTE: the URLs below are used ONLY when you run the backend directly on
# the host (outside Docker) for development. In the Docker stack, the
# compose file overrides all of them with internal service-DNS names
# (http://mediamtx:8889, etc.), so you don't need to edit these for a
# normal `./start.sh` install. Leave them as-is unless you're doing
# host-native backend dev.
MEDIAMTX_BASE_URL=http://localhost:8889
MEDIAMTX_ADMIN_API=http://localhost:9997/v3
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_HLS_URL=http://localhost:8888
MEDIAMTX_RTSP_URL=rtsp://localhost:8554
MEDIAMTX_PLAYBACK_URL=http://localhost:9996
MEDIAMTX_STREAM_PREFIX=cam-
MEDIAMTX_PATH_MODE=id
MEDIAMTX_AUTO_PROVISION=True

# Recording segment length in seconds (3600 = 1-hour files).
RECORDING_SEGMENT_SECONDS=3600

# ============================================================
# DOCKER SERVICE NETWORKING
# ============================================================
BACKEND_HOST=opennvr_core
BACKEND_PORT=8000

# ============================================================
# RECORDING STORAGE
# ============================================================
# Path on the HOST where recordings are stored (created automatically if missing).
# Windows: C:/opennvr/recordings   Linux: /var/lib/opennvr/recordings
RECORDINGS_PATH=./recordings

# Local timezone for recording placement (IANA name, e.g. Asia/Kolkata).
# Recording directories/files are named in this timezone and the playback
# page's date selection covers local midnight -> midnight. Passed to both
# the mediamtx and opennvr_core containers — they must agree.
# The installer prompts for this and defaults to the machine's detected
# timezone; leave unset here so that default isn't masked. When unset,
# docker-compose falls back to UTC.
#TZ=Asia/Kolkata

# ============================================================
# AI INFERENCE (KAI-C + AI Adapters)
# ============================================================
# Controls which adapters KAI-C loads: local_only | cloud_allowed
# Set local_only for the stricter, fully offline mode: KAI-C then refuses any
# adapter that declares external network egress. All bundled adapters ship
# their weights baked in and declare no egress, so they register cleanly
# under either mode.
AI_SOVEREIGNTY=cloud_allowed

# Capture inference frames from MediaMTX's loopback path instead of opening a
# second RTSP session to the camera. True is best for almost everyone; set
# false only when MediaMTX and KAI-C run on different hosts.
INFERENCE_USE_MEDIAMTX_TAP=true

# Server inference path through KAI-C: governed (default — audited
# /api/v1/infer with NATS fan-out) | v1 (ungoverned passthrough, escape
# hatch) | legacy (pre-contract shared-volume URIs).
# OPENNVR_ADAPTER_CONTRACT=governed

# Image tag for ghcr.io/open-nvr/core. Pinned to the current release so a
# fresh install gets the tested core↔adapter pairing. Set "latest" or "main"
# for bleeding-edge main builds.
CORE_TAG=0.1.4

# Camera-agent LLM runtime. EMPTY (default) = the bundled ollama
# container — fine on Linux hosts, but on macOS / Windows the container
# runs in a VM with NO GPU access, so agent turns take minutes of pure
# CPU. Set this to an Ollama (or Ollama-compatible) endpoint running ON
# THE HOST to use the machine's real GPU (Metal on Apple Silicon):
#   OLLAMA_EXTERNAL_URL=http://host.docker.internal:11434
# Then: install Ollama on the host, `ollama pull <OLLAMA_MODEL>`, and
# start.sh automatically adds docker-compose.camera-agent.external-llm.yml
# (which skips the bundled ollama container and its 3.2 GB image).
# The interactive installer defaults to the host machine on macOS (and
# whenever a host Ollama already answers on :11434), and to the bundled
# container on Linux servers — native Docker, no VM/GPU penalty, fully
# compose-managed. Left EMPTY here on purpose: a pre-filled URL would
# break fresh Linux installs where nothing listens on the host.
OLLAMA_EXTERNAL_URL=

# Vision (caption/VQA) model when CAPTION_ADAPTER=ollamavlm — the OLLAMA
# MODEL the adapter asks your Ollama to run. Naming note, because it trips
# people: this "moondream" is Ollama's moondream2 MODEL and has nothing to
# do with choosing the moondream ADAPTER above — with CAPTION_ADAPTER=
# ollamavlm no in-container weights are downloaded at all; Ollama serves
# whatever model this names. It follows OLLAMA_EXTERNAL_URL, so scene
# descriptions run on the same host Ollama (GPU on macOS) as the LLM. The
# stack pre-pulls this model at ``up`` (bundled Ollama) or tells you the
# host command (host Ollama); large models (gemma3:4b, qwen2.5vl) are
# multi-GB, so until the pull finishes describe answers honestly report
# "still downloading". Any Ollama MULTIMODAL model works. moondream
# (~1.8B) is the lightest and the safe pick for CPU-only bundled Ollama —
# but the weakest describer (bad viewpoints/lighting can read as
# "empty"). gemma3:4b is FIELD-TESTED with the agent and clearly answers
# better — the installer suggests it wherever RAM allows (>= 8 GB); set
# it here yourself on a copy-paste install with headroom. On a host GPU,
# qwen3-vl:4b is a further accuracy jump, and qwen3-vl:8b bigger still
# (both untested with the agent so far).
OLLAMA_VLM_MODEL=moondream

# Image tag for all GHCR adapter images (whisper, piper, yolov8, blip,
# moondream, …). Pinned to the current release; set "latest" for bleeding edge.
ADAPTER_TAG=0.1.4

# Tag for the CAPTION_ADAPTER image only (falls back to ADAPTER_TAG when
# empty/unset). Adapter releases from 0.1.4 on publish the ollamavlm
# image, so this stays blank and every adapter rides ADAPTER_TAG.
CAPTION_ADAPTER_TAG=

# Optional example selected by the interactive installer. Leave blank for core only.
OPENNVR_EXAMPLE=
OPENNVR_EXAMPLE_COMPOSE=
OPENNVR_EXAMPLE_PROFILE=

# Apps that run BY DEFAULT on every install: occupancy-counting and
# footage-search. Both ride the always-on Tier-0 detection stream — no extra
# adapter, model, or GPU — so a stock install gets zone occupancy alerts and
# natural-language footage search ("red truck yesterday") out of the box.
# Set to "off" to run the core stack only.
OPENNVR_DEFAULT_APPS=

KAI_C_URL=http://127.0.0.1:8100
KAI_C_IP=127.0.0.1

# ============================================================
# DEFAULT ADMIN USER
# ============================================================
# Leave DEFAULT_ADMIN_PASSWORD blank - setup-token flow handles first login securely.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_EMAIL=admin@opennvr.local
DEFAULT_ADMIN_FIRST_NAME=System
DEFAULT_ADMIN_LAST_NAME=Administrator

# ============================================================
# NGINX TLS REVERSE PROXY
# ============================================================
# The host's LAN IP: goes into the TLS cert SAN and tells ONVIF camera
# discovery which subnet the host is really on (the core container only sees
# the Docker bridge otherwise). start.sh / start.ps1 auto-detect if unset.
#OPENNVR_HOST_IP=192.168.1.100

# Multi-NIC hosts: comma-separated IPs, one per LAN-facing NIC, so camera
# discovery scans every subnet (e.g. a dedicated camera network on a second
# adapter). start.sh / start.ps1 auto-detect if unset.
#OPENNVR_LAN_IPS=192.168.1.100,192.168.0.200

# Dual-NIC: set both to isolate camera traffic from operator traffic.
#CAMERA_NETWORK_INTERFACE=eth0
#MGMT_NETWORK_INTERFACE=eth1

# Manual nginx bind IP (auto-set by start.sh - only override if auto-detection is wrong).
#NGINX_BIND_HOST=0.0.0.0

# The address(es) MediaMTX advertises as WebRTC ICE host candidates, and the
# base URL browsers use to reach this server. Both are auto-detected and
# written here by start.sh - set them by hand only when auto-detection is
# wrong (behind NAT, or a multi-NIC host where the wrong NIC wins).
#
# Why they matter: MediaMTX runs on the Docker bridge, so left to itself it
# can only advertise 127.0.0.1 and 172.28.0.x - neither of which a LAN
# browser can route to. With no usable candidate, ICE never completes, every
# WHEP session dies on a 10s timeout, and Live View silently falls back to
# HLS (working, but seconds of latency instead of sub-second).
#
# You normally do NOT need to set these: the backend keeps its own DB-backed
# list, re-applies it to MediaMTX on every MediaMTX start, and learns the
# address browsers actually reach it on - so a recreated container or a new
# DHCP lease repairs itself. These are the first-boot seed.
#
# MEDIAMTX_WEBRTC_HOSTS takes a comma-separated list for multi-NIC or VPN.
#MEDIAMTX_WEBRTC_HOSTS=192.168.1.100
#MEDIAMTX_PUBLIC_URL=https://192.168.1.100

# WebRTC ICE media port (UDP + TCP), published on NGINX_BIND_HOST.
#
# Leave this unset and the launcher probes for a bindable port at startup,
# falling back through 8189 -> 18189 -> 28189 -> 38189 and saying so loudly
# if it has to move. That matters on Windows, where WinNAT/Hyper-V reserves
# port ranges that are re-rolled at every boot: a port inside one is
# unbindable even while completely idle, and a single failed binding aborts
# ALL of mediamtx's port publications — which kills Live View with no
# visible error, since the stack still comes up and reports healthy.
#
# Set it explicitly to pin a stable port for firewall rules or router
# port-forwards. An explicit value is never auto-overridden: if it cannot be
# bound the launcher fails with an explanation rather than moving silently.
# Inspect the reserved ranges with:
#   netsh interface ipv4 show excludedportrange protocol=tcp   (and udp)
#WEBRTC_ICE_PORT=8189

# Publish MediaMTX's HLS (8888), WebRTC signalling (8889), playback (9996)
# and admin API (9997) on 127.0.0.1. Off by default: browsers reach the first
# three through nginx and the healthcheck queries the API from inside the
# container, so nothing needs them on the host — and every extra publication
# is another chance for one unbindable port to abort ALL of mediamtx's port
# publications. Turn on for host-side debugging or to run the backend outside
# Docker (docs/LOCAL_DEV_CHECKLIST.md).
#OPENNVR_DEBUG_PORTS=1

# Docker bridge subnets - override only if 172.28/16 or 172.29/16 collide with your LAN.
#OPENNVR_DOCKER_SUBNET=172.28.0.0/16
#OPENNVR_PUBLIC_SUBNET=172.29.0.0/16

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=INFO
LOG_FILE_ENABLED=True
LOG_FILE_PATH=logs/server.log
LOG_FILE_MAX_SIZE_MB=50
LOG_FILE_BACKUP_COUNT=10
LOG_CONSOLE_ENABLED=True
LOG_JSON_FORMAT=False

# ============================================================
# YOLOv8 MODEL (standard stack)
# ============================================================
# The standard stack copies pre-baked ONNX weights from this image on first
# boot. Override to ship your own fine-tuned model (build recipe in
# examples/yolov8-weights/README.md). After changing, wipe the cache:
# docker volume rm open-nvr_opennvr_yolov8_weights
#YOLOV8_WEIGHTS_IMAGE=ghcr.io/open-nvr/yolov8-weights:v8.3.0
#YOLOV8_WEIGHTS_URL=https://your-mirror.example.com/yolov8n.onnx
#YOLOV8_PT_URL=https://github.com/ultralytics/assets/releases/download/v8.3.0/yolov8s.pt

# ============================================================
# CAMERA-AGENT (voice assistant overlay)
# ============================================================
# Ollama model for the voice agent - must support tool calling.
# Options: qwen2.5:0.5b (low RAM) | qwen2.5:1.5b (default) |
# qwen3:1.7b (FIELD-TESTED: better answers at similar speed, ~3 GB —
# the installer suggests it where RAM allows; the agent disables its
# thinking mode) | qwen2.5:3b (best of the qwen2.5 family)
OLLAMA_MODEL=qwen2.5:1.5b

# Whisper STT model size: tiny.en | base.en (default) | small.en (most accurate)
WHISPER_MODEL_SIZE=base.en

# Caption adapter for describe_camera:
#   ollamavlm  (default — proxies scene questions to the same Ollama the
#              LLM uses: the host Ollama when OLLAMA_EXTERNAL_URL is set
#              (GPU-fast on macOS: ~1-2 s per caption vs ~25 s of VM CPU),
#              the bundled ollama container otherwise. Auto-pulls
#              OLLAMA_VLM_MODEL; one runtime serves both models; same
#              adapter contract and audited KAI-C path as the others.)
#   moondream  (VQA + captions with in-container weights — switch to this
#              if you'd rather not run the VLM through Ollama. Note the
#              ollamavlm image ships in adapter releases from 0.1.4 on —
#              pinning ADAPTER_TAG to anything older needs
#              CAPTION_ADAPTER_TAG=latest, see above.)
#   blip       (captions only, runs inside Docker — lightest option.)
CAPTION_ADAPTER=ollamavlm

OLLAMA_KEEP_ALIVE=-1
